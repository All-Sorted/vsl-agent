{
  "name": "vsl-agent",
  "version": "1.2",
  "categories": [
    "content",
    "video"
  ],
  "moduleSubdir": "vsl-agent",
  "dependencies": {
    "packages": {},
    "scripts": {}
  },
  "optionalComponents": [
    "A member may connect their own approved writing or rendering workflow after review."
  ],
  "target": {
    "requiredPaths": [
      ".allsorted-target.json"
    ],
    "shape": {
      "requiredPaths": [
